<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Handle API routes - direct /api/* to api.php
    # This matches any request starting with /api/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api.php [L,QSA]

    # 2. Handle Static Files
    # If the file exists, serve it directly (js, css, images)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. React SPA Fallback
    # If the request is not for a real file or the API, send to index.html
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.html [L]
</IfModule>

# Security: Disable directory browsing
Options -Indexes

# Performance: Enable Gzip compression if supported
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
